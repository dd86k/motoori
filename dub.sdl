name "motoori"
description "Online error database project"
authors "dd86k"
copyright "None"
license "CC0-1.0"

# Extractor code, renamed folder to "extractor" as it was
# conflicting with some weird linux folder behavior
subPackage {
	name "extract"
	targetName "extract"
	description "Error message extractor"
	sourcePaths "extractor"
	importPaths "extractor"
}

# Server code
dependency "ddhttpd" repository="git+https://github.com/dd86k/ddhttpd.git" version="6eb787275b2494b41872e7eb7a28304e924104af"

subPackage {
	name "integration-memleak"
	targetName "integration-memleak"
	description "Integration test for memory leak detection"
	targetType "executable"
	sourcePaths "integration"
	importPaths "integration"
}

buildType "debugv" {
	buildOptions "debugMode"
	dflags "-vgc" "-vtls" platform="dmd"
	dflags "--vgc" platform="ldc"
}
