/// Category of a symbolic name, `other` when the table does not carry it.
BugCodeCategory bugcodeCategory(const(char)[] name)
{
    size_t low;
    size_t high = bugcodes.length;

    while (low < high)
    {
        size_t mid = low + ((high - low) / 2);
        if (bugcodes[mid].name < name)
            low = mid + 1;
        else if (bugcodes[mid].name > name)
            high = mid;
        else
            return bugcodes[mid].category;
    }

    return BugCodeCategory.other;
}

/// Whether a bug check only takes a dump, leaving the system running.
bool bugcodeLiveDump(const(char)[] name)
{
    import utils : indexOfFold;

    // indexOfFold folds the text against a needle that is already lowercase
    return indexOfFold(name, "livedump") >= 0 || indexOfFold(name, "live_dump") >= 0;
}

unittest
{
    import std.algorithm.sorting : isSorted;

    // The search depends on it, and the table is written by hand
    assert(isSorted!"a.name < b.name"(bugcodes));

    // Every category the groups list is one the table uses, and the other way round
    foreach (ref immutable(BugCode) code; bugcodes)
    {
        bool listed;
        foreach (ref immutable(BugCodeGroup) group; bugcodeGroups)
            listed = listed || group.category == code.category;
        assert(listed);
    }

    assert(bugcodeCategory("APC_INDEX_MISMATCH")  == BugCodeCategory.kernel);
    assert(bugcodeCategory("NTFS_FILE_SYSTEM")    == BugCodeCategory.storage);
    assert(bugcodeCategory("WINDOWS_NT_BANNER")   == BugCodeCategory.informational);
    assert(bugcodeCategory("NOT_A_REAL_BUGCHECK") == BugCodeCategory.other);

    assert(bugcodeLiveDump("SMB_SERVER_LIVEDUMP"));
    assert(bugcodeLiveDump("BUGCODE_NDIS_DRIVER_LIVE_DUMP"));
    assert(bugcodeLiveDump("APC_INDEX_MISMATCH") == false);
}
