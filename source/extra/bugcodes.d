/// Subsystem each bug check belongs to.
///
/// Neither bugcodes.h nor the Microsoft documentation says what part of the
/// system a stop code comes from: the header is in numeric order and their own
/// index is one flat table. So the mapping is by hand, one entry per symbolic,
/// which is also why a name the table does not carry reads as `other` rather
/// than being guessed at from its words.
module extra.bugcodes;

/// Part of the system a bug check comes from
enum BugCodeCategory
{
    other,
    kernel,
    memory,
    drivers,
    verifier,
    storage,
    display,
    network,
    cluster,
    hardware,
    power,
    security,
    virtualization,
    boot,
    debugging,
    phone,
    xbox,
    informational,
}

/// A category, as a listing renders it
struct BugCodeGroup
{
    BugCodeCategory category;
    string name;
    string description;
}

/// Display order: the subsystems behind most stop codes first, then the ones
/// tied to a platform, and last what is not a stop code at all.
immutable BugCodeGroup[] bugcodeGroups = [
    { BugCodeCategory.kernel, "Kernel",
      "The core kernel: IRQL rules, locks, threads, processes, and traps." },
    { BugCodeCategory.memory, "Memory manager",
      "Paging, pool, page table entries, and the page frame database." },
    { BugCodeCategory.drivers, "Drivers",
      "Driver misbehaviour the kernel caught, across IRPs, PnP, and the device stack." },
    { BugCodeCategory.verifier, "Driver Verifier",
      "Violations only Driver Verifier or special pool is watching for." },
    { BugCodeCategory.storage, "Storage and file systems",
      "File system drivers, volumes, disks, and the storage stack under them." },
    { BugCodeCategory.display, "Graphics and window manager",
      "Display drivers, the DirectX kernel, and win32k." },
    { BugCodeCategory.network, "Networking",
      "NDIS and the protocol stack, plus the file sharing that rides on it." },
    { BugCodeCategory.hardware, "Hardware and firmware",
      "Machine checks, ACPI, the HAL, processors, and the buses in between." },
    { BugCodeCategory.power, "Power management",
      "Power state transitions, sleep, and the policy coordinator." },
    { BugCodeCategory.security, "Security and integrity",
      "Code integrity, cryptography, tokens, and tamper detection." },
    { BugCodeCategory.virtualization, "Virtualization and secure kernel",
      "The hypervisor and the isolated kernel running under it." },
    { BugCodeCategory.boot, "Boot and startup",
      "Failures before the system is up: boot devices, hives, and phase initialization." },
    { BugCodeCategory.cluster, "Failover clustering",
      "Cluster shared volumes and the cluster service watching them." },
    { BugCodeCategory.debugging, "Debugging and diagnostics",
      "Dumps taken deliberately, and the instrumentation that takes them." },
    { BugCodeCategory.phone, "Windows Phone",
      "The SAVER codes, from the Windows Phone and Mobile builds." },
    { BugCodeCategory.xbox, "Xbox",
      "Codes reserved for the Xbox system software." },
    { BugCodeCategory.other, "Other",
      "Codes with too little documentation to place." },
    { BugCodeCategory.informational, "Not stop codes",
      "Strings sharing the header with the stop codes: the boot banner, the safe mode "~
      "and boot log notices, and the hardware profile prompts." },
];

